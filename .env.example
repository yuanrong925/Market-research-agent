# ============================================================
#  日志配置（新增）
# ============================================================

# 日志等级：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=DEBUG

# 是否保存日志文件（true/false）
LOG_SAVE_FILE=true

# 单日志文件最大容量（如 10MB, 100MB, 1GB）
LOG_MAX_SIZE=10MB

# 日志文件保留天数
LOG_RETENTION_DAYS=7
